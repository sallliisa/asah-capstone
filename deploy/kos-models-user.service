[Unit]
Description=Kos tenant and intent model service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/app/models
EnvironmentFile=%h/app/models/.env
ExecStart=%h/app/models/.venv/bin/uvicorn kos_models.server:app --host 127.0.0.1 --port 5195 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
MemoryMax=2G
CPUQuota=150%

[Install]
WantedBy=default.target
