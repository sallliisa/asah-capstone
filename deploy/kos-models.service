[Unit]
Description=Kos model service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kos
Group=kos
WorkingDirectory=/opt/kos/services/models
EnvironmentFile=/etc/kos/models.env
ExecStart=/opt/kos/services/models/.venv/bin/uvicorn kos_models.server:app --host 127.0.0.1 --port 5195 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=2G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
