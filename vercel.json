{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "vercel.mjs",
      "buildCommand": "pnpm run type-check && pnpm run routes:compile .sprindle-vercel/routes.mjs"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
